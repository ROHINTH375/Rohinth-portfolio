# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# Secret used to read messages: GET /api/contact with header  x-admin-key: <ADMIN_KEY>
ADMIN_KEY=change-me-to-a-long-random-string

# Only needed if the frontend is hosted on a different domain from the API (comma-separated)
CLIENT_ORIGIN=

# Local server port
PORT=5000

# Only needed if the frontend calls an API on another domain, e.g. https://api.example.com
VITE_API_URL=
